NODE_ENV=development
PORT=4001
PUBLIC_ORIGIN=http://localhost:4001
MONGODB_URI=mongodb://127.0.0.1:27017/clothing_store
SESSION_SECRET=replace-with-at-least-32-random-characters
TRACKING_PEPPER=replace-with-a-different-long-random-secret
STORE_NAME=Development Clothing Store
WHATSAPP_NUMBER=
RESERVATION_MINUTES=60
# Persistent product images (required before launch)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SMTP and PayHere remain disabled until fully configured/tested.
SMTP_URL=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
