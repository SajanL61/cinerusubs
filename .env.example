# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:4001
NEXT_PUBLIC_SITE_NAME=CineruSubs
MONGODB_URI=mongodb://127.0.0.1:27017/cinerusubs
MONGODB_DB=cinerusubs
SESSION_SECRET=replace-with-at-least-32-random-characters
DOWNLOAD_SIGNING_SECRET=replace-with-a-different-long-random-secret
CINERUSUBS_DEMO_MODE=false

# Cloudflare R2 (server only; never prefix these with NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_MEDIA_BUCKET=cinerusubs-media
R2_ASSETS_BUCKET=cinerusubs-assets
PUBLIC_ASSET_DOMAIN=https://assets.cinerusubs.com
DOWNLOAD_DOMAIN=https://dl.cinerusubs.com
DOWNLOAD_WORKER_ENABLED=false

# Optional integrations
TMDB_API_TOKEN=
NEXT_PUBLIC_TMDB_ATTRIBUTION_ENABLED=true
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# One-time administrator creation (clear after use)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
