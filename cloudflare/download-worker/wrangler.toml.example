name = "cinerusubs-downloads"
main = "src/index.js"
compatibility_date = "2026-10-01"

routes = [
  { pattern = "dl.cineseya.lk/*", zone_name = "cineseya.lk" }
]

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "cinerusubs-media"

[vars]
MEDIA_BUCKET_NAME = "cinerusubs-media"

# Set without committing it:
# wrangler secret put DOWNLOAD_SIGNING_SECRET
