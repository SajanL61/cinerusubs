{
  "name": "clothing-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:demo": "tsx server/demo.ts",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr client/entry-server.tsx --outDir dist/ssr",
    "build:server": "tsup server/index.ts server/worker.ts server/cli.ts --format esm --out-dir dist/server --sourcemap --external vite",
    "build": "npm run build:client && npm run build:ssr && npm run build:server",
    "start": "node dist/server/index.js",
    "worker": "tsx server/worker.ts",
    "worker:prod": "node dist/server/worker.js",
    "seed": "tsx server/cli.ts seed",
    "create-owner": "tsx server/cli.ts create-owner",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.544.0",
    "mongodb-memory-server": "^10.2.1",
    "mongoose": "^8.18.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-router-dom": "^7.9.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.2"
  }
}
